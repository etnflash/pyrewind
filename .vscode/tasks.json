{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "PyRewind: 현재 파일 시각화",
      "type": "shell",
      "command": "python",
      "args": ["-m", "pyrewind", "${file}"],
      "options": { "env": { "PYTHONPATH": "${workspaceFolder}" } },
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "dedicated", "clear": true }
    }
  ]
}
