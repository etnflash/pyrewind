{
  "name": "pyrewind",
  "displayName": "PyRewind — 한줄씩 되감는 파이썬",
  "description": "파이썬 코드를 한 줄씩 앞뒤로 되감으며 변수가 만들어지고 바뀌는 과정을 에디터 옆에서 봅니다 (.py / .ipynb, pandas, 한국어 오류 도우미)",
  "version": "0.2.1",
  "publisher": "etnflash",
  "license": "MIT",
  "icon": "icon.png",
  "galleryBanner": { "color": "#1e4a72", "theme": "dark" },
  "repository": { "type": "git", "url": "https://github.com/etnflash/pyrewind" },
  "homepage": "https://github.com/etnflash/pyrewind#readme",
  "bugs": { "url": "https://github.com/etnflash/pyrewind/issues" },
  "engines": { "vscode": "^1.85.0" },
  "categories": ["Debuggers", "Education", "Visualization"],
  "keywords": ["python", "jupyter", "pandas", "visualize", "education", "debugger", "korean", "step"],
  "main": "./extension.js",
  "activationEvents": ["onLanguage:python", "onNotebook:jupyter-notebook"],
  "contributes": {
    "commands": [
      { "command": "pyrewind.run", "title": "현재 파일 시각화", "category": "PyRewind", "icon": "$(play-circle)" },
      { "command": "pyrewind.runSelection", "title": "선택한 부분만 시각화 (선택 / # %% 블록 / 셀)", "category": "PyRewind", "icon": "$(debug-step-into)" },
      { "command": "pyrewind.jumpToLine", "title": "이 줄이 실행되는 시점으로 이동", "category": "PyRewind" },
      { "command": "pyrewind.next", "title": "다음 단계", "category": "PyRewind" },
      { "command": "pyrewind.prev", "title": "이전 단계", "category": "PyRewind" },
      { "command": "pyrewind.openInBrowser", "title": "브라우저에서 열기", "category": "PyRewind", "icon": "$(link-external)" },
      { "command": "pyrewind.clear", "title": "시각화 닫기 / 강조 지우기", "category": "PyRewind" }
    ],
    "menus": {
      "editor/title": [
        { "command": "pyrewind.openInBrowser", "when": "activeWebviewPanelId == pyrewind", "group": "navigation" },
        { "command": "pyrewind.run", "when": "resourceLangId == python", "group": "navigation" }
      ],
      "notebook/toolbar": [
        { "command": "pyrewind.run", "when": "notebookType == jupyter-notebook", "group": "navigation/execute" }
      ],
      "editor/context": [
        { "command": "pyrewind.runSelection", "when": "editorLangId == python", "group": "navigation@99" },
        { "command": "pyrewind.jumpToLine", "when": "pyrewind.active && editorLangId == python", "group": "navigation@100" }
      ],
      "notebook/cell/title": [
        { "command": "pyrewind.runSelection", "when": "notebookType == jupyter-notebook && notebookCellType == code", "group": "inline" }
      ],
      "explorer/context": [
        { "command": "pyrewind.run", "when": "resourceExtname == .py || resourceExtname == .ipynb", "group": "navigation@100" }
      ],
      "commandPalette": [
        { "command": "pyrewind.jumpToLine", "when": "pyrewind.active" },
        { "command": "pyrewind.openInBrowser", "when": "pyrewind.active" },
        { "command": "pyrewind.next", "when": "pyrewind.active" },
        { "command": "pyrewind.prev", "when": "pyrewind.active" }
      ]
    },
    "keybindings": [
      { "command": "pyrewind.run", "key": "ctrl+alt+v", "mac": "cmd+alt+v", "when": "!terminalFocus" },
      { "command": "pyrewind.run", "key": "ctrl+shift+f5", "mac": "cmd+shift+f5", "when": "resourceExtname == .py || resourceExtname == .ipynb || activeEditor == 'workbench.editor.notebook'" },
      { "command": "pyrewind.runSelection", "key": "ctrl+alt+shift+v", "mac": "cmd+alt+shift+v", "when": "editorTextFocus && editorLangId == python" },
      { "command": "pyrewind.next", "key": "ctrl+alt+]", "mac": "cmd+alt+]", "when": "pyrewind.active" },
      { "command": "pyrewind.prev", "key": "ctrl+alt+[", "mac": "cmd+alt+[", "when": "pyrewind.active" },
      { "command": "pyrewind.jumpToLine", "key": "ctrl+alt+j", "mac": "cmd+alt+j", "when": "pyrewind.active && editorTextFocus" }
    ],
    "configuration": {
      "title": "PyRewind",
      "properties": {
        "pyrewind.pythonPath": {
          "type": "string",
          "default": "",
          "markdownDescription": "사용할 python 실행 파일 경로. 비워 두면 **Python 확장에서 선택한 인터프리터**를 쓰고, 그것도 없으면 `python` 을 씁니다."
        },
        "pyrewind.maxSteps": {
          "type": "number",
          "default": 3000,
          "description": "기록할 최대 단계 수 (무한 루프 방지)"
        },
        "pyrewind.runOnSave": {
          "type": "boolean",
          "default": false,
          "description": "시각화 중인 파일을 저장하면 자동으로 다시 실행"
        },
        "pyrewind.inlineValues": {
          "type": "boolean",
          "default": true,
          "description": "에디터 줄 끝에 변수 변화(예: total: 5 → 14)를 표시"
        },
        "pyrewind.timeoutSeconds": {
          "type": "number",
          "default": 60,
          "description": "실행 제한 시간(초)"
        }
      }
    }
  }
}
